// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        String   @id @default(uuid()) // @id - означает, что это primary key + автоматически генерирует UUID.
  title     String
  completed Boolean  @default(false) // по умолчанию false
  createdAt DateTime @default(now()) // автоматически ставит текущее время создания.
  updatedAt DateTime @updatedAt // автоматически обновляет поле при update.
}
